# Local x86 development image. cmd/vgw is currently REGISTER-only; the
# bundled local-ari-lab binary is synthetic ARI media research, NOT an
# office Eventphone↔SPA112 voice release. No credential is copied here.
FROM golang:1.27.1-bookworm@sha256:e114385c58e7280d2f56d6cf374219dda33fef8eb77f72e9f290ccae6160bd90 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/vgw ./cmd/vgw
COPY cmd/local-ari-lab ./cmd/local-ari-lab
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -buildvcs=false \
    -o /out/vgw ./cmd/vgw && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -buildvcs=false \
    -o /out/local-ari-lab ./cmd/local-ari-lab

FROM debian:bookworm-slim@sha256:c67e92c8099ba22853ab4cfda7cfb494d253d6012ca82dee98ba8976772af018
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/vgw /usr/local/bin/vgw
COPY --from=build /out/local-ari-lab /usr/local/bin/local-ari-lab
LABEL org.opencontainers.image.title="noll-vgw-development" \
      org.opencontainers.image.description="REGISTER-only vgw and synthetic local ARI lab; no office call service"
# Development dry run never requires a service-specific passwd/shadow entry.
# An owned deployment explicitly selects its runtime UID:GID at launch.
USER nobody
ENTRYPOINT ["/usr/local/bin/vgw"]
# The entrypoint without flags is a network-free dry run.
